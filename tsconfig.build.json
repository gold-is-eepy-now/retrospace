  "compilerOptions": {
    "noEmit": false,
    "outDir": "./build",
    "declaration": false,
    "sourceMap": false,
    "allowImportingTsExtensions": false,
    "types": []
  },
  "include": [
    "index.tsx",
    "App.tsx",
    "types.ts",
    "components/**/*.tsx",
    "services/**/*.ts"
  ]
}
